(defun c:RLX (/ ss count objects sortedObjects leftObj rightObj minX maxX totalWidth spacing currentX i obj boundingBox leftPt)
    (princ "\nВыберите объекты для распределения по горизонтали (левый край): ")
    (setq ss (ssget))
    (if (and ss (> (sslength ss) 2))
        (progn
            (vl-load-com)
            (setq count (sslength ss))
            (setq objects '())
            (setq i 0)
            (while (< i count)
                (setq ent (ssname ss i))
                (setq boundingBox (getBoundingBox ent))
                (if boundingBox
                    (progn
                        (setq leftPt (car boundingBox))
                        (setq objects (cons (list ent leftPt (car leftPt)) objects))
                    )
                )
                (setq i (1+ i))
            )
            (setq sortedObjects (vl-sort objects '(lambda (a b) (< (caddr a) (caddr b)))))
            (setq leftObj (car sortedObjects))
            (setq rightObj (last sortedObjects))
            (setq minX (caddr leftObj))
            (setq maxX (caddr rightObj))
            (setq totalWidth (- maxX minX))
            (setq spacing (/ totalWidth (1- count)))
            (command "_.UNDO" "_Begin")
            (setq i 0)
            (foreach obj sortedObjects
                (if (and (/= i 0) (/= i (1- count)))
                    (progn
                        (setq targetX (+ minX (* spacing i)))
                        (setq currentX (caddr obj))
                        (setq deltaX (- targetX currentX))
                        (if (not (equal deltaX 0.0 1e-8))
                            (command "._MOVE" (car obj) "" "0,0" (list deltaX 0.0 0.0))
                        )
                    )
                )
                (setq i (1+ i))
            )
            (command "_.UNDO" "_End")
            (princ (strcat "\nРаспределено объектов по горизонтали: " (itoa count)))
            (sssetfirst nil ss)
        )
        (if ss
            (princ "\nДля распределения нужно выбрать как минимум 3 объекта.")
            (princ "\nОбъекты не выбраны.")
        )
    )
    (princ)
)

