; Основная команда для вызова диалогового окна
(defun c:ALIGNTOOLS (/ dcl_id)
    (setq dcl_id (load_dialog "AlignTools_advanced.dcl"))
    
    (if (not (new_dialog "align_tools" dcl_id))
        (progn
            (princ "\nОшибка загрузки диалогового окна!")
            (unload_dialog dcl_id)
            (exit)
        )
    )
    
    ; Назначение действий для кнопок
    (action_tile "al" "(done_dialog 1)")
    (action_tile "ar" "(done_dialog 2)")
    (action_tile "at" "(done_dialog 3)")
    (action_tile "ab" "(done_dialog 4)")
    (action_tile "acx" "(done_dialog 5)")
    (action_tile "acy" "(done_dialog 6)")

    (action_tile "rlx" "(done_dialog 7)")
    (action_tile "rrx" "(done_dialog 8)")
    (action_tile "rty" "(done_dialog 9)")
    (action_tile "rby" "(done_dialog 10)")
    (action_tile "rcx" "(done_dialog 11)")
    (action_tile "rcy" "(done_dialog 12)")
    (action_tile "rzx" "(done_dialog 13)")
    (action_tile "rzy" "(done_dialog 14)")

    (action_tile "rlxd" "(done_dialog 15)")
    (action_tile "rrxd" "(done_dialog 16)")
    (action_tile "rtyd" "(done_dialog 17)")
    (action_tile "rbyd" "(done_dialog 18)")
    (action_tile "rcxd" "(done_dialog 19)")
    (action_tile "rcyd" "(done_dialog 20)")
    (action_tile "rzxd" "(done_dialog 21)")
    (action_tile "rzyd" "(done_dialog 22)")
    
    (action_tile "accept" "(done_dialog 23)")
    (action_tile "cancel" "(done_dialog 0)")
    
    (setq result (start_dialog))
    (unload_dialog dcl_id)
    
    ; Вызов соответствующей команды в зависимости от результата
    (cond
        ((= result 1) (c:AL))
        ((= result 2) (c:AR))
        ((= result 3) (c:AT))
        ((= result 4) (c:AB))
        ((= result 5) (c:ACX))
        ((= result 6) (c:ACY))
		
        ((= result 7) (c:RLX))
        ((= result 8) (c:RRX))
        ((= result 9) (c:RTY))
        ((= result 10) (c:RBY))
        ((= result 11) (c:RCX))
        ((= result 12) (c:RCY))
        ((= result 13) (c:RZX))
        ((= result 14) (c:RZY))
		
        ((= result 15) (c:RLXD))
        ((= result 16) (c:RRXD))
        ((= result 17) (c:RTYD))
        ((= result 18) (c:RBYD))
        ((= result 19) (c:RCXD))
        ((= result 20) (c:RCYD))
        ((= result 21) (c:RZXD))
        ((= result 22) (c:RZYD))
		
        ((= result 23) (princ "\nДиалог закрыт"))
        ((= result 0) (princ "\nОтменено"))
    )
    (princ)
)

; Команда быстрого доступа (короткое имя)
(defun c:ATOOLS ()
    (c:ALIGNTOOLS)
)

; ============================================
; ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
; ============================================

; Функция для получения bounding box объекта
(defun getBoundingBox (ent / minPoint maxPoint)
    (if (and ent (entget ent))
        (progn
            (vla-getboundingbox (vlax-ename->vla-object ent) 'minPoint 'maxPoint)
            (list
                (vlax-safearray->list minPoint)
                (vlax-safearray->list maxPoint)
            )
        )
    )
)

; ============================================
; ФУНКЦИИ ВЫРАВНИВАНИЯ (6 функций)
; ============================================

(defun c:AL (/ ss i ent minX boundingBox leftPt deltaX)
    (princ "\nВыберите объекты для выравнивания по левому краю: ")
    (setq ss (ssget))
    (if ss
        (progn
            (vl-load-com)
            (setq minX 1e308)
            (setq i 0)
            (while (< i (sslength ss))
                (setq ent (ssname ss i))
                (setq boundingBox (getBoundingBox ent))
                (if boundingBox
                    (progn
                        (setq leftPt (car boundingBox))
                        (if (< (car leftPt) minX) (setq minX (car leftPt)))
                    )
                )
                (setq i (1+ i))
            )
            (command "_.UNDO" "_Begin")
            (setq i 0)
            (while (< i (sslength ss))
                (setq ent (ssname ss i))
                (setq boundingBox (getBoundingBox ent))
                (if boundingBox
                    (progn
                        (setq leftPt (car boundingBox))
                        (setq deltaX (- minX (car leftPt)))
                        (if (not (equal deltaX 0.0 1e-8))
                            (command "._MOVE" ent "" "0,0" (list deltaX 0.0 0.0))
                        )
                    )
                )
                (setq i (1+ i))
            )
            (command "_.UNDO" "_End")
            (princ (strcat "\nВыровнено объектов по левому краю: " (itoa (sslength ss))))
            (sssetfirst nil ss)
        )
        (princ "\nОбъекты не выбраны.")
    )
    (princ)
)

