(defun c:ACX (/ ss i ent boundingBoxList minX maxX centerX deltaX)
    (princ "\nВыберите объекты для выравнивания по центру (X): ")
    (setq ss (ssget))
    (if ss
        (progn
            (vl-load-com)
            (setq boundingBoxList '())
            (setq minX 1e308)
            (setq maxX -1e308)
            (setq i 0)
            (while (< i (sslength ss))
                (setq ent (ssname ss i))
                (setq boundingBox (getBoundingBox ent))
                (if boundingBox
                    (progn
                        (setq boundingBoxList (cons (list ent boundingBox) boundingBoxList))
                        (setq leftPt (car boundingBox))
                        (setq rightPt (cadr boundingBox))
                        (if (< (car leftPt) minX) (setq minX (car leftPt)))
                        (if (> (car rightPt) maxX) (setq maxX (car rightPt)))
                    )
                )
                (setq i (1+ i))
            )
            (command "_.UNDO" "_Begin")
            (setq centerX (/ (+ minX maxX) 2.0))
            (foreach item boundingBoxList
                (setq ent (car item))
                (setq boundingBox (cadr item))
                (setq objLeft (car (car boundingBox)))
                (setq objRight (car (cadr boundingBox)))
                (setq objCenterX (/ (+ objLeft objRight) 2.0))
                (setq deltaX (- centerX objCenterX))
                (if (not (equal deltaX 0.0 1e-8))
                    (command "._MOVE" ent "" "0,0" (list deltaX 0.0 0.0))
                )
            )
            (command "_.UNDO" "_End")
            (princ (strcat "\nВыровнено объектов по центру (X): " (itoa (length boundingBoxList))))
            (sssetfirst nil ss)
        )
        (princ "\nОбъекты не выбраны.")
    )
    (princ)
)

