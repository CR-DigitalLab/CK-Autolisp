            (vl-load-com)
            (setq distance (get-distance-with-default "\nУкажите расстояние между объектами (любое значение)"))
            (if (not (null distance))
                (progn
                    (setq count (sslength ss))
                    (setq objects '())
                    (setq i 0)
                    (while (< i count)
                        (setq ent (ssname ss i))
                        (setq boundingBox (getBoundingBox ent))
                        (if boundingBox
                            (progn
                                (setq bottomPt (car boundingBox))
                                (setq topPt (cadr boundingBox))
                                (setq objHeight (- (cadr topPt) (cadr bottomPt)))
                                (setq objects (cons (list ent (cadr bottomPt) objHeight) objects))
                            )
                        )
                        (setq i (1+ i))
                    )
                    (setq sortedObjects (vl-sort objects '(lambda (a b) (< (cadr a) (cadr b)))))
                    (command "_.UNDO" "_Begin")
                    (setq currentY (cadr (car sortedObjects)))
                    (setq i 0)
                    (foreach obj sortedObjects
                        (setq targetY currentY)
                        (setq deltaY (- targetY (cadr obj)))
                        (if (not (equal deltaY 0.0 1e-8))
                            (command "._MOVE" (car obj) "" "0,0" (list 0.0 deltaY 0.0))
                        )
                        (setq currentY (+ targetY (caddr obj) distance))
                        (setq i (1+ i))
                    )
                    (command "_.UNDO" "_End")
                    (princ (strcat "\nРаспределено объектов по вертикали с расстоянием " (rtos distance) " между объектами: " (itoa count)))
                    (sssetfirst nil ss)
                )
                (princ "\nРасстояние не указано.")
            )
        )
        (if ss
            (princ "\nДля распределения нужно выбрать как минимум 2 объекта.")
            (princ "\nОбъекты не выбраны.")
        )
    )
    (princ)
)




;; Функция для сброса сохраненного расстояния
(defun c:RD-RESET ()
    (setq *rd-last-distance* nil)
    (princ "\nСохраненное расстояние для всех команд распределения сброшено.")
    (princ)
)


;; Функция для просмотра сохраненного расстояния
(defun c:RD-SHOW ()
    (princ (strcat "\nТекущее сохраненное расстояние: " 
                   (if (> *rd-last-distance* nil)
                       (rtos *rd-last-distance*)
                       "не установлено")))
    (princ)
)


