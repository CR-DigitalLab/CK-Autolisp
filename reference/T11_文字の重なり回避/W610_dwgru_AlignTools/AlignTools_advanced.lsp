;; Глобальная переменная для хранения последнего расстояния
(if (not *rd-last-distance*)
    (setq *rd-last-distance* nil)  ; было 0.0
)


;; Вспомогательная функция для получения ограничивающей рамки
(defun getBoundingBox (ent / minPt maxPt)
    (vla-getboundingbox (vlax-ename->vla-object ent) 'minPt 'maxPt)
    (list (vlax-safearray->list minPt) (vlax-safearray->list maxPt))
)

;; Общая функция для запроса расстояния с сохранением (разрешены любые значения)
(defun get-distance-with-default (prompt / dist)
    (setq dist (getdist 
        (strcat prompt 
                (if (not (null *rd-last-distance*))
                    (strcat " <" (rtos *rd-last-distance*) ">: ")
                    ": ")
        )
    ))
    
    (if (null dist)
        (if (not (null *rd-last-distance*))
            (setq dist *rd-last-distance*)
            (progn
                (princ "\nСохраненное расстояние отсутствует. Укажите расстояние: ")
                (setq dist (getdist))
            )
        )
    )
    
    (if (not (null dist))
        (progn
            (setq *rd-last-distance* dist)
            dist
        )
        nil
    )
)

